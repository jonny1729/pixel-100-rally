{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "database.spark.rules.json"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.spark.json", "firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=31536000,immutable" }]
      }
    ]
  }
}
